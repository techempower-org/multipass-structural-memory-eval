baselines/*_model/
*.safetensors

# Local corpora caches
sme/corpora/*/.cache/

# External benchmark data (downloaded, not checked in)
data/

# Private corpora (authored against personal content — build your own
# via sme/corpora/standard_v0_1/AUTHORING.md)
sme/corpora/climate_research_v01/
sme/corpora/personal_kg_pkm_v01/
sme/corpora/canadian_politics_v01/

# jp-realm flat (Condition A) ChromaDB — binary, rebuilt from the committed
# sanitized flat_source.jsonl via scripts/ingest_jprealm_flat_chroma.py (#125)
sme/corpora/jp_realm_v0_1/flat_chroma/

# Local working artifacts — kept local, not for the public repo:
#  - HANDOFF.md: per-session durable status / next-steps notes
#  - .archive/: retired/archival session handoffs
#  - docs/related_work/wip/: drafts with unverified (training-data)
#    citations; must be primary-source-verified before publishing
HANDOFF.md
.archive/
docs/related_work/wip/

# Internal cross-repo commit journal — never publish (see 54f54ac)
commits/
